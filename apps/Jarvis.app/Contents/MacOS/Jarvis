#!/bin/bash
# Mach-O-free launcher. Launch Services will open a bash stub; a Python
# shebang as CFBundleExecutable is rejected (-10669).
SUPPORT="$HOME/Library/Application Support/jarvis"
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ -n "$JARVIS_ROOT" ] && [ -d "$JARVIS_ROOT/backtalk" ]; then
  ROOT="$JARVIS_ROOT"
elif [ -f "$SUPPORT/install_root" ]; then
  ROOT="$(cat "$SUPPORT/install_root")"
else
  ROOT="$(cd "$HERE/../../../.." && pwd)"
fi
OV="$ROOT/ai-visualizer/.overlay-venv/bin/python"
HOST="$HERE/jarvis-host.py"
if [ ! -x "$OV" ]; then
  OV="$(command -v python3)"
fi
if [ ! -d "$ROOT/backtalk" ]; then
  echo "[jarvis-app] no install at $ROOT — run ./setup.sh from the clone" >&2
  exit 1
fi
export JARVIS_ROOT="$ROOT"
exec "$OV" "$HOST"
